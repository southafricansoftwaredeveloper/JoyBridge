<Window x:Class="ThinClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThinClient"
        xmlns:viewModels="clr-namespace:ThinClient.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{x:Static viewModels:MainViewModel.DesignInstance}"
        Title="MainWindow" Height="450" Width="800">
        
        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
        
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontWeight="Bold" Margin="4" Width="250"/>
                        <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" Margin="4"/>
                </StackPanel>
        
                <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" AutoGenerateColumns="True" IsReadOnly="True"/>
        
        </Grid>
        
</Window>
